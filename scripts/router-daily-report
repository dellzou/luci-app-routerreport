    </table>
  </td></tr>

  $( [ -n "$TIP" ] && echo "<tr><td style=\"padding:16px 26px 0;\"><div class=\"h\">运维提示</div><ul class=\"tips\">$TIP</ul></td></tr>" )

  <tr><td style="padding:18px 26px 24px;">
    <div style="border-top:1px solid #eaecef;padding-top:12px;font-size:11.5px;color:#8b949e;line-height:1.7;">
