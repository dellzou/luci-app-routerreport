# ---------- 7.5 超长行折行保险 ----------
# RFC5321 规定单行 ≤ 998 字节，QQ SMTP 严格校验并直接拒收（500 Line too long）。
# 邮件头不参与折行（base64 编码的 Subject 折行会损坏），只折空行之后的正文。
if awk 'length($0)>900{f=1} END{exit (f?0:1)}' "$TMP.mail" 2>/dev/null; then
	awk 'BEGIN{h=1} h{print; if($0=="")h=0; next}
	     { s=$0
	       while(length(s)>900){ i=900; while(i>1 && substr(s,i,1)!=" ")i--; if(i<=1)i=900
	         print substr(s,1,i-1); s=substr(s,i+1) }
	       print s }' "$TMP.mail" > "$TMP.mail.fold" && mv "$TMP.mail.fold" "$TMP.mail"
	logger -t router-daily-report "邮件正文存在超长行（>900 字节），已自动折行"
fi

# ---------- 8. 发送 ----------
if [ "$DRYRUN" -eq 1 ]; then
	cp "$TMP.mail" /tmp/rd-preview.mail
	echo "DRY-RUN: 邮件正文已生成 -> /tmp/rd-preview.mail"
	echo "主题: $SUBJECT"
	echo "收件人: $RECIPIENT  发件人: $FROM_ADDR"
	echo "流量: 下行 $HUM_DOWN / 上行 $HUM_UP / 需关注异常 $REAL_N 条 / 覆盖率 $COVERAGE%"
	exit 0
fi

[ -n "$RECIPIENT" ] || { logger -t router-daily-report "未配置 RECIPIENT，放弃发送"; exit 1; }

OK=0; I=1
while [ "$I" -le "$MAX_RETRY" ]; do
	if msmtp -a "$MSMTP_ACCOUNT" "$RECIPIENT" < "$TMP.mail" 2>>"$LOGDIR/msmtp.log"; then
		OK=1; break
	fi
	logger -t router-daily-report "第 $I 次发送失败，${RETRY_WAIT}s 后重试"
	[ "$I" -lt "$MAX_RETRY" ] && sleep "$RETRY_WAIT"
	I=$(( I + 1 ))
done

if [ "$OK" -eq 1 ]; then
	touch "$SENT_FLAG"
	logger -t router-daily-report "日报已发送至 $RECIPIENT（$YDAY，异常 $REAL_N 条）"
else
	mkdir -p "$DIR/failed"
	cp "$TMP.mail" "$DIR/failed/report-$YDAY.mail"
	logger -t router-daily-report "日报发送失败，已存至 $DIR/failed/report-$YDAY.mail"
	exit 1
fi
exit 0
