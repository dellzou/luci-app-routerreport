# 统一换行：仓库内存 LF，避免 Windows 上 checkout 出 CRLF 破坏 shell/Lua 脚本
* text=auto eol=lf

# 二进制：不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# 明确脚本类型（保证在路由器上可执行）
*.sh     text eol=lf
*.lua    text eol=lf
*.htm    text eol=lf
router-metrics      text eol=lf
router-daily-report text eol=lf
router-logarchive   text eol=lf
router-report-apply text eol=lf
